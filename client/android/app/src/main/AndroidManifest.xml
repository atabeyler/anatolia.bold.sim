<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- LoginPage.tsx's navigator.geolocation.getCurrentPosition() (login
         screen's decorative coordinate readout) silently fails with no OS
         prompt at all without these: WebView geolocation requests are
         blocked by Android itself before Capacitor's BridgeWebChromeClient
         ever gets a chance to relay a runtime permission dialog. It always
         requests both COARSE and FINE together (see
         onGeolocationPermissionsShowPrompt in @capacitor/android) and on
         pre-12 devices treats a request for an undeclared permission as
         denied, so both must be declared even though only a rough lat/lon
         display is needed here. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- ApkUpdaterPlugin.java's in-app install flow: required to launch the
         ACTION_VIEW package-archive intent for a sideloaded update at all
         (separate from the canRequestPackageInstalls() app-op check, which
         is granted per-source through Android's own settings screen). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
