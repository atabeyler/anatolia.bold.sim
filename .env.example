# Database
DATABASE_URL=postgresql://user:password@localhost:5432/anatolia_sim

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# Admin setup (used by POST /api/admin/seed-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_USER_CODE=ADMIN001
ADMIN_PASSWORD=change_me_strong_password
ADMIN_SEED_TOKEN=change_me_to_a_secret_token

# AI (Gemini — BOLD analysis chat, hypothesis testing, ARIA voice assistant,
# God Mode "speak to individual"). Every one of these features falls back to
# a deterministic heuristic/echo response when this is unset, so it's
# optional for local dev.
GEMINI_API_KEY=AIzaSy...
# Optional model override; defaults to gemini-2.0-flash.
GEMINI_MODEL=
ELEVENLABS_API_KEY=
NODE_ENV=development
PORT=3001
